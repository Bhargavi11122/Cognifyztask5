<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=1, initial-scale=1.0">
    <title>Task5-Third-party API Integration</title>
    <link href="https;//cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-dark bg-dark mb-5">
        <div class="container">
            <span class="navbar-brand mb-0 h1">Cognifyz Internship -Task 5 Dashboard</span>
        </div>
    </nav>
    <div  class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8">
                <div class="card shadow-sm p-4">
                    <h2 class="text-muted text-success mb-4">Live Todo List</h2>
                    <p class="text-muted text-center mb-4"> The data shown below was fetched in real-time directly from the JSONPlaceholder API using Node.js. </p>
                    <% if (error) { %>
                        <div class="alert alert-danger text-center"><%= error %></div>
                    <% } %>
                    <% if (typeof todos !=='undefined' && todos.length > 0) { %>
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped table-hover align-middle">
                                <thead class="table-success text-center">
                                    <tr>
                                        <th>Task ID </th>
                                        <th> Task Title</th>
                                        <th> Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% todos.forEach(todo => { %>
                                        <tr>
                                            <td class="text-center fw-bold"><%= todo.id %></td>
                                            <td><%= todo.title %></td>
                                            <td class="text-center">
                                                <% if (todo.completed) { %>
                                                    <span class="badge bg-success">completed ✔</span>
                                                <% } else { %>
                                                    <span class="badge bg-warning text-dark"> pending 🕐</span>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <p class="text-center text-muted"> No Data.</p>
                    <% } %>
                    
                        
                        <button type="submit" class="btn btn-primary w-100">Submit</button>
                    </form>
                    <% if(typeof error!=='undefined'){%>
                        <div class="alert alert-danger mt-3 text-center" ><%= error %></div>
                    <% } %>
                    <% if(typeof success!=='undefined'){%>
                        <div class="alert alert-success mt-3 text-center" ><%= success %></div>
                    <% } %>
                </div>
            </div>
        </div> 
    </div>   
     
</body>
</html>     
            